<?xml version="1.0" encoding="utf-8"?>
<!--
  매니페스트는 앱의 배포 서술자다. 서버로 치면 web.xml 에 가깝지만 역할이 더 크다.
  OS 는 앱을 설치할 때 이 파일만 읽고도 "이 앱에 어떤 진입점이 있고 무엇을 요구하는지"를
  전부 파악한다. 여기 선언되지 않은 컴포넌트는 코드에 있어도 OS 가 부르지 않는다.

  이 파일은 APK 안에 들어간다. 즉 여기를 고치면 반드시 재설치가 필요하다.
  (권한 추가, 새 진입점 추가 등). docs/CODE-TOUR.md 의 "재설치 경계" 참고

  참고: XML 주석은 태그의 속성 사이에 넣을 수 없고, 주석 안에 붙임표 두 개를
  연달아 쓸 수도 없다. 둘 다 빌드가 깨진다.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      권한. 두 종류가 섞여 있다.

      설치할 때 자동으로 주어지는 것 (사용자에게 묻지 않음):
        INTERNET               웹앱을 내려받아야 하므로 필수
        RECEIVE_BOOT_COMPLETED 재부팅 뒤 알람을 다시 걸기 위해
        VIBRATE                알림 진동

      사용자에게 따로 물어야 하는 것:
        POST_NOTIFICATIONS     안드로이드 13+ 에서 실행 중에 물어본다
        SCHEDULE_EXACT_ALARM   안드로이드 12+ 에서 설정 화면으로 보내 켜게 한다

      뒤 두 개는 선언만으로는 아무 효력이 없다. 코드에서 요청해야 하고, 사용자가
      거절하면 그 기능은 조용히 동작하지 않는다. 예외도 로그도 안 남는다.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      android:name    프로세스가 뜰 때 가장 먼저 만들어질 클래스 (HennyApp)
      android:allowBackup="false"
                      구글 자동 백업을 끈다. 켜 두면 기기를 바꿀 때 예전
                      localStorage 가 딸려 와, 팀 저장소의 최신 자료를 덮어써
                      되돌릴 수 있다.
    -->
    <application
        android:name=".HennyApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="false"
        android:theme="@style/Theme.Henny">

        <!--
          android:exported="true"
              런처에서 띄우려면 다른 앱(런처)에 열려 있어야 한다.
              안드로이드 12+ 는 intent-filter 가 있으면 명시를 강제한다.

          android:launchMode="singleTop"
              알림을 눌러 들어올 때 같은 화면을 새로 쌓지 않고 기존 것을 쓴다.

          android:configChanges="..."
              이 목록에 적힌 변화가 생겨도 Activity 를 부수고 다시 만들지 않는다.
              기본 동작은 "화면을 회전하면 Activity 를 죽였다 새로 만든다"인데,
              그러면 WebView 가 통째로 새로 로드되어 사용자가 보던 화면과 입력이
              날아간다. 여기서는 WebView 하나뿐이라 직접 처리하는 편이 낫다.

          android:windowSoftInputMode="adjustResize"
              키보드가 올라올 때 화면을 밀지 않고 줄인다. 이게 있어야 WebView 가
              작아진 영역을 인식하고, 웹 쪽 visualViewport 값도 실제로 바뀐다.
              adjustPan 이면 화면을 통째로 밀어 올려 웹이 상황을 알 수 없다.
              (web/app.css 의 .backdrop 이 이 값에 의존한다)
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Henny">
            <!-- 이 필터가 있어야 런처 목록에 아이콘이 뜬다. 앱의 대문. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 우리 알람만 받는다. exported=false 라 다른 앱은 부를 수 없다. -->
        <receiver
            android:name=".notify.AlarmReceiver"
            android:exported="false" />

        <!--
          시스템이 보내는 방송을 받으므로 exported=true 여야 한다.
          네 가지 모두 "걸어 둔 알람 예약이 사라졌거나 기준이 달라진" 순간이다.
            BOOT_COMPLETED       재부팅 (예약이 전부 사라짐)
            MY_PACKAGE_REPLACED  앱 업데이트 (마찬가지)
            TIME_SET             사용자가 시계를 바꿈
            TIMEZONE_CHANGED     시간대 변경 (epoch 시각의 벽시계 의미가 달라짐)
        -->
        <receiver
            android:name=".notify.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
